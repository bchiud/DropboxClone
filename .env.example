# ---- MongoDB Atlas ----
# From Atlas: Database > Connect > Drivers. Replace <password> with your DB user's password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dropbox_clone

# ---- Backblaze B2 (S3-compatible) ----
# Sign up (no credit card) > B2 Cloud Storage > create a bucket.
# Then App Keys > Add a New Application Key (scope to the bucket, read+write).
# Endpoint: shown on the bucket details as "Endpoint", e.g. s3.us-west-004.backblazeb2.com
# It must include the https:// scheme for boto3.
S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
S3_ACCESS_KEY_ID=your_b2_keyID
S3_SECRET_ACCESS_KEY=your_b2_applicationKey
S3_REGION=us-west-004  # the region embedded in your endpoint (e.g. us-west-004)
S3_BUCKET=dropbox-clone-blocks
S3_URL_TTL_SECONDS=300

# ---- Auth (JWT) ----
# JWT_SECRET is REQUIRED. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Optional (defaults shown) — override only if you want to.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
SHARE_LINK_EXPIRE_MINUTES=10080

# ---- Realtime (pub/sub) ----
# REDIS_URL=redis://localhost:6379